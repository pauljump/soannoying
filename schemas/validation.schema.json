{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solution validation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "proposal_id", "method", "setting", "baseline", "outcome", "failure_cases", "limitations"],
  "properties": {
    "id": { "type": "string", "pattern": "^validation-[a-z0-9-]+$" },
    "status": { "enum": ["validated", "inconclusive", "failed"] },
    "proposal_id": { "type": "string", "pattern": "^proposal-[a-z0-9-]+$" },
    "method": { "type": "string", "minLength": 1 },
    "setting": { "type": "string", "minLength": 1 },
    "baseline": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "failure_cases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
