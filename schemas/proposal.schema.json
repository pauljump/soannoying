{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI solution proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "problem_id", "intervention", "ai_capability", "control_point", "consent_boundary", "non_ai_alternative", "success_metric", "risks"],
  "properties": {
    "id": { "type": "string", "pattern": "^proposal-[a-z0-9-]+$" },
    "status": { "const": "proposed" },
    "problem_id": { "type": "string", "pattern": "^problem-[a-z0-9-]+$" },
    "intervention": { "type": "string", "minLength": 1 },
    "ai_capability": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "control_point": { "type": "string", "minLength": 1 },
    "consent_boundary": { "type": "string", "minLength": 1 },
    "non_ai_alternative": { "type": "string", "minLength": 1 },
    "success_metric": { "type": "string", "minLength": 1 },
    "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
